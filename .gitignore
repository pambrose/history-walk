.*/
# The dot-directories are ignored, except the GitHub workflows and Dependabot config, and the Kotlin/JS yarn lock
!.github/
!.kotlin-js-store/
build/
out/
*.imp
*.ipr
*.iws
*.iml
*.idea

logs/
secrets/
.env

# The docs site: its build output is not kept, but website/uv.lock is, so the Website workflow builds with the Zensical
# it pins, even for someone whose global gitignore drops *.lock
website/history-walk/site/
!website/uv.lock

# The client's npm packages, pinned so CI builds what a release ships (build.gradle.kts), kept for the same reason
!.kotlin-js-store/yarn.lock
